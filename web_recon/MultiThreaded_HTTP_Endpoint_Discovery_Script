import requests
from concurrent.futures import ThreadPoolExecutor

# Get user inputs
target_url = input('Enter the target URL (e.g., http://example.com): ').strip()
file_name = input('Enter name of the file containing directories: ').strip()

# Define status codes you actually care about seeing
VALID_STATUS_CODES = {200, 301, 302, 403, 401}

def check_directory(dir_name):
    dir_name = dir_name.strip()
    # Skip empty lines or comments
    if not dir_name or dir_name.startswith('#'):
        return

    full_url = f"{target_url.rstrip('/')}/{dir_name}"
    
    try:
        # allow_redirects=False helps catch 301/302 redirects explicitly
        response = requests.get(full_url, timeout=5, allow_redirects=False)
        
        # Filter check: Only print if the status code is in our target set
        if response.status_code in VALID_STATUS_CODES:
            print(f"[+] Found ({response.status_code}): {full_url}")
            
    except requests.exceptions.RequestException:
        # Silently pass connection errors, timeouts, or DNS failures
        pass

def main():
    try:
        with open(file_name, 'r') as file:
            directories = file.readlines()
    except FileNotFoundError:
        print(f"[-] Error: The file '{file_name}' was not found.")
        return

    print(f"\n[*] Starting scan on {target_url} using 10 concurrent threads...\n")

    # ThreadPoolExecutor handles running multiple requests simultaneously
    with ThreadPoolExecutor(max_workers=10) as executor:
        executor.map(check_directory, directories)

    print("\n[*] Scan complete.")

if __name__ == '__main__':
    main()
